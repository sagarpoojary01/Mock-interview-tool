# Copy this file to .env and fill in your values. Never commit .env.

# MySQL (recommended). For a zero-setup start use: sqlite:///./preppilot.db
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/preppilot

# Long random string used to sign login tokens
SECRET_KEY=change-me-to-a-long-random-string

# Free key from https://console.groq.com . If empty, the app uses a built-in mock AI.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
